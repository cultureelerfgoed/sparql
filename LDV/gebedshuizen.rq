#+ name: gebedshuizen
#+ endpoint: https://api.linkeddata.cultureelerfgoed.nl/datasets/rce/gebedshuizen/sparql

PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX ceox: <https://linkeddata.cultureelerfgoed.nl/def/ceox#>

CONSTRUCT {
  ?gebedshuis ?p1 ?o1 .
  ?o1 ?p2 ?o2 .
  ?o2 ?p3 ?o3 .
  ?o3 ?p4 ?o4 .
  ?o4 ?p5 ?o5 .

  ?gemeenteURI skos:prefLabel ?gemeenteLabel .
  ?denominatieURI skos:prefLabel ?denominatieLabel .
}
WHERE {

  {
    SELECT DISTINCT ?gebedshuis
    WHERE {

      GRAPH <https://linkeddata.cultureelerfgoed.nl/rce/gebedshuizen/graphs/default> {

        ?gebedshuis rdf:type ceox:Gebedshuis .

        # Naam
        FILTER(
          !BOUND(?zoekNaam)
          ||
          EXISTS {
            ?gebedshuis ceox:heeftNaam ?naamResource .
            ?naamResource ceox:naam ?naam .

            FILTER(
              CONTAINS(
                LCASE(STR(?naam)),
                LCASE(STR(?zoekNaam))
              )
            )
          }
        )

        # Gemeente
        FILTER(
          !BOUND(?zoekGemeente)
          ||
          EXISTS {
            ?gebedshuis
              ceox:heeftAdresgegevens ?adresResource .

            ?adresResource
              ceox:heeftGemeente ?gemeenteURI .

            ?gemeenteURI
              skos:prefLabel ?gemeenteLabel .

            FILTER(
              LANGMATCHES(
                LANG(?gemeenteLabel),
                "nl"
              )
            )

            FILTER(
              CONTAINS(
                LCASE(STR(?gemeenteLabel)),
                LCASE(STR(?zoekGemeente))
              )
            )
          }
        )

        # Woonplaats
        FILTER(
          !BOUND(?zoekWoonplaats)
          ||
          EXISTS {
            ?gebedshuis
              ceox:heeftAdresgegevens ?adresResource .

            ?adresResource
              ceox:woonplaats ?woonplaats .

            FILTER(
              CONTAINS(
                LCASE(STR(?woonplaats)),
                LCASE(STR(?zoekWoonplaats))
              )
            )
          }
        )

        # Denominatie
        FILTER(
          !BOUND(?zoekDenominatie)
          ||
          EXISTS {
            ?gebedshuis
              ceox:heeftDenominatie ?denominatieResource .

            ?denominatieResource
              ceox:heeftDenominatieNaam ?denominatieURI .

            ?denominatieURI
              skos:prefLabel ?denominatieLabel .

            FILTER(
              LANGMATCHES(
                LANG(?denominatieLabel),
                "nl"
              )
            )

            FILTER(
              CONTAINS(
                LCASE(STR(?denominatieLabel)),
                LCASE(STR(?zoekDenominatie))
              )
            )
          }
        )

        # Minimaal één zoekveld
        FILTER(
          BOUND(?zoekNaam)
          ||
          BOUND(?zoekGemeente)
          ||
          BOUND(?zoekWoonplaats)
          ||
          BOUND(?zoekDenominatie)
        )
      }
    }
  }

  # Alle data van gevonden gebedshuizen
  GRAPH <https://linkeddata.cultureelerfgoed.nl/rce/gebedshuizen/graphs/default> {

    ?gebedshuis ?p1 ?o1 .

    OPTIONAL {

      FILTER(
        isIRI(?o1)
        &&
        STRSTARTS(
          STR(?o1),
          "https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/gebedshuizen/"
        )
      )

      ?o1 ?p2 ?o2 .

      OPTIONAL {

        FILTER(
          isIRI(?o2)
          &&
          STRSTARTS(
            STR(?o2),
            "https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/gebedshuizen/"
          )
        )

        ?o2 ?p3 ?o3 .

        OPTIONAL {

          FILTER(
            isIRI(?o3)
            &&
            STRSTARTS(
              STR(?o3),
              "https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/gebedshuizen/"
            )
          )

          ?o3 ?p4 ?o4 .

          OPTIONAL {

            FILTER(
              isIRI(?o4)
              &&
              STRSTARTS(
                STR(?o4),
                "https://linkeddata.cultureelerfgoed.nl/cho-kennis/id/gebedshuizen/"
              )
            )

            ?o4 ?p5 ?o5 .
          }
        }
      }
    }

    # Gemeentelabel meenemen
    OPTIONAL {

      ?gebedshuis
        ceox:heeftAdresgegevens ?adresVoorGemeente .

      ?adresVoorGemeente
        ceox:heeftGemeente ?gemeenteURI .

      ?gemeenteURI
        skos:prefLabel ?gemeenteLabel .

      FILTER(
        LANGMATCHES(
          LANG(?gemeenteLabel),
          "nl"
        )
      )
    }

    # Denominatielabel meenemen
    OPTIONAL {

      ?gebedshuis
        ceox:heeftDenominatie ?denominatieVoorLabel .

      ?denominatieVoorLabel
        ceox:heeftDenominatieNaam ?denominatieURI .

      ?denominatieURI
        skos:prefLabel ?denominatieLabel .

      FILTER(
        LANGMATCHES(
          LANG(?denominatieLabel),
          "nl"
        )
      )
    }
  }
}