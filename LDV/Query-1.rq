#+ name: Query-1
prefix graph: <https://rce.triply.cc/koop/owms/graphs/>
prefix owms: <http://standaarden.overheid.nl/owms/terms/>
prefix skos: <http://www.w3.org/2004/02/skos/core#>
 

select * where {
  GRAPH <http://standaarden.overheid.nl/owms/terms/> {
  ?s a owms:Gemeente.
  ?s skos:prefLabel ?gemeentenaam.
} }